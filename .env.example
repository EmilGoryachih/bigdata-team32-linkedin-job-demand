# Copy this file to .env and fill in real values.
# .env is gitignored — never commit secrets.

# ---------------------------------------------------------------------------
# PostgreSQL ingestion (stage 1)
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=linkedin_jobs
DB_USER=team32
DB_PASSWORD=changeme

# Where raw CSVs live for the Python loader (scripts/load_postgres.py).
DATA_DIR=./data/raw

# ---------------------------------------------------------------------------
# Hive / HDFS (stages 2 and 3)
# ---------------------------------------------------------------------------
HDFS_BASE=/user/team32/linkedin
HIVE_DB=team32_linkedin
BEELINE_URL=jdbc:hive2://hadoop-03.uni.innopolis.ru:10001
HIVE_USER=team32
HIVE_PASSWORD=changeme

# ---------------------------------------------------------------------------
# Spark (stage 3)
# ---------------------------------------------------------------------------
# Override these if running outside YARN (e.g. SPARK_MASTER=local[*]).
SPARK_MASTER=yarn
SPARK_DEPLOY_MODE=client
